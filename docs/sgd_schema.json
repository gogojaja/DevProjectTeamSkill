{
  "$schema": "SGD v1.1 — 结构化目标定义机器验证 schema（补强版）",
  "_comment": "v1.1 补强：scope 读写分离 / constraints 可验证 / 持久化台账 / 变更机制",
  "type": "object",
  "required": ["statement", "acceptance_criteria"],
  "properties": {
    "statement": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200,
      "description": "一句话目标（5~200 字符）"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "description", "verify_type"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-\\d+$" },
          "description": { "type": "string", "minLength": 5 },
          "verify_type": {
            "type": "string",
            "enum": ["file_exists", "file_contains", "command_pass", "test_pass", "count_ge", "manual"],
            "description": "验证类型枚举"
          },
          "verify_target": { "type": "string", "description": "验证目标（文件路径/命令/数量）" },
          "verify_arg": { "type": "string", "description": "验证参数（搜索内容/阈值等，可选）" }
        }
      },
      "description": "可验证验收标准（1~20 条，每条必须含 verify_type）"
    },
    "constraints": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "oneOf": [
          { "type": "string", "description": "v1.0 兼容：纯文字声明（不可机器验证，仅提醒）" },
          {
            "type": "object",
            "required": ["type", "target"],
            "properties": {
              "type": { "type": "string", "enum": ["file_not_modified", "file_not_created", "content_not_changed"], "description": "约束验证类型" },
              "target": { "type": "string", "description": "约束目标（文件路径/glob）" },
              "description": { "type": "string", "description": "约束说明" }
            },
            "description": "v1.1 可验证约束"
          }
        ]
      },
      "description": "操作边界（v1.0 纯文字 / v1.1 可机器验证对象）"
    },
    "scope": {
      "type": "object",
      "properties": {
        "write_files": { "type": "array", "items": { "type": "string" }, "description": "v1.1 允许写入的文件 glob（替代旧 files）" },
        "write_dirs": { "type": "array", "items": { "type": "string" }, "description": "v1.1 允许写入的目录（替代旧 dirs）" },
        "read_files": { "type": "array", "items": { "type": "string" }, "description": "v1.1 允许读取的文件 glob（默认不限）" },
        "read_dirs": { "type": "array", "items": { "type": "string" }, "description": "v1.1 允许读取的目录（默认不限）" },
        "files": { "type": "array", "items": { "type": "string" }, "description": "v1.0 兼容：等同 write_files" },
        "dirs": { "type": "array", "items": { "type": "string" }, "description": "v1.0 兼容：等同 write_dirs" }
      },
      "description": "v1.1 读写分离范围锁定（v1.0 files/dirs 向后兼容）"
    },
    "max_iterations": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 },
    "tier3_explicit": {
      "type": "array",
      "items": { "type": "string" },
      "description": "预声明的 Tier 3 操作列表"
    },
    "error_recovery": {
      "type": "object",
      "properties": {
        "max_retries_per_step": { "type": "integer", "minimum": 0, "maximum": 3, "default": 1, "description": "单步最大重试次数" },
        "on_circuit_break": { "type": "string", "enum": ["pause_wait_user", "skip_and_continue", "abort_goal"], "default": "pause_wait_user", "description": "熔断后行为" },
        "on_max_iterations": { "type": "string", "enum": ["handoff", "abort_goal", "pause_wait_user"], "default": "handoff", "description": "达到最大轮次后行为" }
      },
      "description": "v1.1 错误恢复策略"
    }
  }
}
