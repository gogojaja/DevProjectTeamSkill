{
  "$schema": "SGD v1.0 — 结构化目标定义机器验证 schema",
  "_comment": "AI 从用户自然语言生成此 JSON，工具可机器验证格式合法性",
  "type": "object",
  "required": ["statement", "acceptance_criteria"],
  "properties": {
    "statement": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200,
      "description": "一句话目标（5~200 字符）"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "description", "verify_type"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-\\d+$" },
          "description": { "type": "string", "minLength": 5 },
          "verify_type": {
            "type": "string",
            "enum": ["file_exists", "file_contains", "command_pass", "test_pass", "count_ge", "manual"],
            "description": "验证类型：file_exists=文件存在 / file_contains=文件含指定内容 / command_pass=命令返回 0 / test_pass=pytest 通过 / count_ge=产出数量≥N / manual=需人工确认"
          },
          "verify_target": { "type": "string", "description": "验证目标（文件路径/命令/数量）" },
          "verify_arg": { "type": "string", "description": "验证参数（搜索内容/阈值等，可选）" }
        }
      },
      "description": "可验证验收标准（1~20 条，每条必须含 verify_type）"
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 10,
      "description": "操作边界/禁止项（可选，0~10 条）"
    },
    "scope": {
      "type": "object",
      "properties": {
        "files": { "type": "array", "items": { "type": "string" }, "description": "允许修改的文件 glob 模式" },
        "dirs": { "type": "array", "items": { "type": "string" }, "description": "允许写入的目录" }
      },
      "description": "Tier 2 操作范围锁定（可选，未指定则按 statement 推断）"
    },
    "max_iterations": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 },
    "tier3_explicit": {
      "type": "array",
      "items": { "type": "string" },
      "description": "预声明的 Tier 3 操作列表（提前告知用户哪些步骤需逐项确认）"
    }
  }
}
