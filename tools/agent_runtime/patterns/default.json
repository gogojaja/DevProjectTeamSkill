{
  "_comment": "默认决策模式 — 已知安全场景的自动响应规则。auto_execute 仅用于已有安全保护的操作。",
  "_version": "1.0.0",
  "patterns": [
    {
      "id": "auto-heal-diverged",
      "description": "远端分叉 → 自动调用 self_heal 修复（有 --force-with-lease + 备份保护）",
      "match": {"event": "git.diverged"},
      "action": "self_heal",
      "params": {"dry_run": false},
      "risk": "Tier3",
      "auto_execute": true,
      "safety_note": "self_heal 内置备份 + --force-with-lease，已有安全保护"
    },
    {
      "id": "commit-run-gates",
      "description": "提交事件 → 跑三道门禁 + 双推（兼容 agent_loop v1 行为）",
      "match": {"event": "git.commit"},
      "action": "run_gates_and_push",
      "params": {},
      "risk": "Tier2",
      "auto_execute": true,
      "safety_note": "门禁未过则不双推，仅记录"
    },
    {
      "id": "gate-fail-escalate",
      "description": "门禁失败 → 阻断推送 + 写待决策队列 + 记录审计",
      "match": {"event": "gate.fail"},
      "action": "escalate",
      "params": {"notify": true, "block_push": true},
      "risk": "Tier2",
      "auto_execute": true,
      "safety_note": "仅阻断和记录，不做破坏性操作"
    },
    {
      "id": "push-fail-retry",
      "description": "推送失败 → 记录待决策（不自动重试，避免死循环）",
      "match": {"event": "git.push_fail"},
      "action": "escalate",
      "params": {"notify": true, "block_push": false},
      "risk": "Tier2",
      "auto_execute": true,
      "safety_note": "仅记录，不自动重试"
    },
    {
      "id": "nightly-quality-scan",
      "description": "定时夜间扫描 → 跑质量门禁 + 脱敏复查",
      "match": {"event": "schedule.tick", "task": "nightly_scan"},
      "action": "nightly_quality_gate",
      "params": {"dry_run": false},
      "risk": "Tier2",
      "auto_execute": true,
      "safety_note": "只读扫描 + 记录，无副作用"
    },
    {
      "id": "health-check-anomaly",
      "description": "健康检查异常 → 诊断 + 记录待决策",
      "match": {"event": "health.check"},
      "action": "escalate",
      "params": {"notify": true, "block_push": false},
      "risk": "Tier1",
      "auto_execute": true,
      "safety_note": "只读诊断 + 记录"
    },
    {
      "id": "code-review-on-commit",
      "description": "OPT-REVIEW-002: 提交后自动代码审查 → T-08 多层分析 → 报告 → 门禁判定",
      "match": {"event": "git.commit", "trigger": "code_review"},
      "action": "code_review",
      "params": {"diff_range": "HEAD~1"},
      "risk": "Tier2",
      "auto_execute": false,
      "safety_note": "只读分析 + 报告落盘，不修改代码"
    },
    {
      "id": "security-scan-nightly",
      "description": "OPT-REVIEW-002: 夜间依赖漏洞扫描 → T-09 + 脱敏扫描 → 安全报告",
      "match": {"event": "schedule.tick", "task": "nightly_scan", "trigger": "security_scan"},
      "action": "security_scan",
      "params": {"offline": false},
      "risk": "Tier2",
      "auto_execute": true,
      "safety_note": "只读扫描 + 记录，无副作用"
    },
    {
      "id": "arch-compliance-check",
      "description": "OPT-REVIEW-002: 周度架构合规检查 → T-10 ADR 约束扫描 → 报告",
      "match": {"event": "schedule.tick", "task": "arch_compliance"},
      "action": "arch_compliance",
      "params": {"adr_dir": "架构资产"},
      "risk": "Tier1",
      "auto_execute": true,
      "safety_note": "只读扫描 + 报告落盘"
    },
    {
      "id": "gate-fail-security",
      "description": "OPT-REVIEW-002: 安全门禁失败 → 阻断 + 升级待决策",
      "match": {"event": "gate.fail", "gate_type": "security"},
      "action": "escalate",
      "params": {"notify": true, "block_push": true, "severity": "high"},
      "risk": "Tier2",
      "auto_execute": true,
      "safety_note": "仅阻断和记录，不做破坏性操作"
    }
  ]
}
