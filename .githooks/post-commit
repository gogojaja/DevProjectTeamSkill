#!/bin/sh
# .githooks/post-commit — 控制环自动化触发（Phase 1）
# 仅当仓库根存在 .agent-loop-enabled 时激活；AGENT_LOOP_ACTIVE=1 防止 agent_loop 自提交台账时递归触发。
if [ ! -f .agent-loop-enabled ] || [ "$AGENT_LOOP_ACTIVE" = "1" ]; then
  exit 0
fi

if command -v python3 >/dev/null 2>&1; then
  # macOS / Linux
  AGENT_LOOP_ACTIVE=1 python3 tools/agent_loop.py --trigger hook || true
elif command -v py >/dev/null 2>&1; then
  # Windows git-bash：py 启动器对 POSIX 相对路径异常(exit 49)，改用 Windows 绝对路径
  WINP=$(pwd -W 2>/dev/null || pwd)
  AGENT_LOOP_ACTIVE=1 py -3.11 "$WINP/tools/agent_loop.py" --trigger hook || true
elif command -v cmd >/dev/null 2>&1; then
  # Windows 兜底：经原生 cmd 调用 py 启动器
  AGENT_LOOP_ACTIVE=1 cmd /c "py -3.11 tools/agent_loop.py --trigger hook" || true
fi
