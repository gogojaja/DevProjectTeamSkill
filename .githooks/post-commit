#!/bin/sh
# .githooks/post-commit — 提交后自动化钩子
# 功能 1：控制环自动化（agent_loop）—— 存在 .agent-loop-enabled 时触发
# 功能 2：技能自动部署（auto-deploy）—— 存在 .auto-deploy-enabled 时自动部署技能到项目级三目录
# 注意: 全局库由 publish_production 独占（生产载体），自动部署仅同步项目级开发目录；如需生产发布请跑 publish_production

ROOT="$(pwd)"

# ============================================================
# 功能 2：技能自动部署（opt-in，需创建 .auto-deploy-enabled）
# 仅当 .trae/skills/ 下的源码有变更时才触发部署
# ============================================================
if [ -f "$ROOT/.auto-deploy-enabled" ] && [ "$AGENT_LOOP_ACTIVE" != "1" ]; then
  # 检查最新提交是否包含技能源码变更
  if git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -q '^\.trae/skills/'; then
    echo "post-commit: 检测到技能源码变更，自动部署到项目级三目录..."

    # 查找 Python 解释器
    PY=""
    if PEXE=$(ls /c/Users/*/AppData/Local/Programs/Python/Python*/python.exe 2>/dev/null | head -1); [ -n "$PEXE" ]; then
      PY="$PEXE"
    elif PEXE=$(ls /c/Python*/python.exe /c/Program*/Python*/python.exe 2>/dev/null | head -1); [ -n "$PEXE" ]; then
      PY="$PEXE"
    elif command -v python3 >/dev/null 2>&1; then
      PY="python3"
    elif command -v python >/dev/null 2>&1; then
      PY="python"
    fi

    if [ -n "$PY" ]; then
      "$PY" "$ROOT/tools/deploy_skills.py" --skip-global 2>&1 || echo "post-commit: 自动部署失败，请手动执行 solidify"
    else
      echo "post-commit: 未找到 Python，跳过自动部署"
    fi
  fi
fi

# ============================================================
# 功能 1：控制环自动化触发（Phase 1）
# 仅当仓库根存在 .agent-loop-enabled 时激活；AGENT_LOOP_ACTIVE=1 防止自提交递归触发。
# ============================================================
if [ ! -f "$ROOT/.agent-loop-enabled" ] || [ "$AGENT_LOOP_ACTIVE" = "1" ]; then
  exit 0
fi

# 解析 Python（关键）：Windows git-bash 下的 python3 / py 启动器运行脚本会异常 exit 49 且无输出，
# 因此优先直搜 Windows 的 python.exe 绝对路径（最稳）；macOS/Linux 用 python3；最后回退 py -3.11 + Windows 路径。
PY=""
if PEXE=$(ls /c/Users/*/AppData/Local/Programs/Python/Python*/python.exe 2>/dev/null | head -1); [ -n "$PEXE" ]; then
  PY="$PEXE"
elif PEXE=$(ls /c/Python*/python.exe /c/Program*/Python*/python.exe 2>/dev/null | head -1); [ -n "$PEXE" ]; then
  PY="$PEXE"
elif command -v python3 >/dev/null 2>&1; then
  PY="python3"
fi

if [ -n "$PY" ]; then
  AGENT_LOOP_ACTIVE=1 "$PY" tools/agent_loop.py --trigger hook || true
elif command -v py >/dev/null 2>&1; then
  WINP=$(pwd -W 2>/dev/null || pwd)
  AGENT_LOOP_ACTIVE=1 py -3.11 "$WINP/tools/agent_loop.py" --trigger hook || true
fi
