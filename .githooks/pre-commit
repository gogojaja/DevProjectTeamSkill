#!/usr/bin/env bash
# ============================================================
# pre-commit 环境门禁钩子（DevProjectTeamSkill 技能库）
# 检查项（铁律 #8 敏感信息分级 + 环境铁律）：
#   1. A 级密钥扫描：真实 Token/私钥/密钥禁止入库（复用 tools/pre-commit-secret-scan.sh）
#   2. B 级脱敏检查：提交内容中的 IP / 绝对路径 / 主机名 需脱敏（含 <挂载卷>、<用户目录>、<Windows盘符> 等）
#   3. 环境配置引用检查：禁止提交 .env 真实值 / .secrets 明文；只允许别名引用
#   4. 大文件门禁：>4K 或 >20 列禁止直接入库（应转 CSV，AGENTS.md 输出格式铁律）
# 失败阻断提交（exit 1），全部通过 exit 0。
# 分发：git config core.hooksPath .githooks（scripts/install-hooks.sh 一键完成）
# ============================================================

set -u

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# 已暂存文件（含新增/修改/复制）
files=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$files" ]; then
  exit 0
fi

fail=0

echo "🔒 pre-commit 环境门禁检查…"

# ---- 1. A 级密钥扫描（复用独立扫描脚本） ----
if [ -f "$repo_root/tools/pre-commit-secret-scan.sh" ]; then
  if ! bash "$repo_root/tools/pre-commit-secret-scan.sh" >/dev/null 2>&1; then
    bash "$repo_root/tools/pre-commit-secret-scan.sh" 2>&1 | grep -v "^$"
    fail=1
  fi
else
  echo "⚠ tools/pre-commit-secret-scan.sh 缺失，跳过 A 级扫描"
fi

# ---- 2. B 级脱敏检查 ----
# 禁止提交的内容：真实 IP（非脱敏 xxx.xxx.xxx.xxx）、绝对路径、含环境敏感的主机名引用
bgrade_pattern='([0-9]{1,3}\.){3}[0-9]{1,3}|(/Volumes/[A-Za-z0-9_]+|[A-Za-z]:\\\\|[A-Za-z]:/|/Users/[A-Za-z0-9_.-]+|/home/[A-Za-z0-9_.-]+)'
for f in $files; do
  case "$f" in
    *.png|*.jpg|*.jpeg|*.gif|*.ico|*.pdf|*.zip|*.lock|*.jar|*.war) continue ;;
    .githooks/*|scripts/*) continue ;;  # 钩子/脚本自身含路径示例，跳过 B 级（仍受 A 级扫描）
    AGENTS.md|交接文档.md|docs/github_ip_records.csv|.trae/skills/dev-project-team-skill/skills/self-improve/domain/versioned-release.md) continue ;;  # GitHub 候选 IP 为公开基础设施 IP；versioned-release.md 含本仓库公开 URL（gogojaja/DevProjectTeamSkill，AGENTS.md 授权保留），豁免 B 级；交接文档为本仓库跨会话断点+审计留痕，含必要真实路径，豁免 B 级
    .trae/skills/shared/references/*|.trae/skills/references/*) continue ;;  # references 标准文档含规范示例路径/IP（如 token_standard/iron_rules/github_access），主库与副本均已入库存证；评审 SEC-002 确认无真实泄漏
  esac
  content=$(git show :"$f" 2>/dev/null) || continue
  # 过滤脱敏示例行（xxx.xxx.xxx.xxx 已合规）与示例占位路径（/home/user/、example.com、file:///、localhost 等，技能库文档含大量版面示例）
  if printf '%s' "$content" | grep -E "$bgrade_pattern" >/dev/null 2>&1; then
    # 排除已脱敏标记 xxx.xxx.xxx.xxx，且剔除示例/占位语义行（非真实环境路径）
    hits=$(printf '%s' "$content" | grep -E "$bgrade_pattern" | grep -v 'xxx\.xxx\.xxx\.xxx' \
      | grep -vE 'https?://[^@[:space:]]+([[:space:]]|$)' \
      | grep -vE '%s?://|%\(.*\)s?://|://%s|://%\(.*\)s' \
      | grep -vE '/home/user/|/Users/user/|example\.(com|org|net)|file:///|localhost|192\.168\.x\.x|myproject_|<.*>|/Volumes/BR256G|C:\\\\|D:\\\\|owner/repo|/repo\.git|pgdata-|redis://redis|\.\.\.|\$repo|maven\.apache\.org|pre-commit-hooks|apps/dco|senate/opencode-senate|startswith|\(\[\^/\]\+\)|\(issues\|pull\)|trufflesecurity|/\{path\}|shellcheck|mirrors-mypy|ruff-pre-commit|file://\{path\}|return f' | head -3)
    if [ -n "$hits" ]; then
      echo "❌ B 级敏感信息未脱敏: $f" >&2
      printf '%s\n' "$hits" | sed 's/^/    /' >&2
      echo "   B 级（主机名/IP/绝对路径）提交公共仓库前必须脱敏（AGENTS.md 铁律 #8）" >&2
      fail=1
    fi
  fi
done

# ---- 3. 环境配置引用检查 ----
# 禁止提交 .env 真实值；.env 文件本身已被 gitignore，防御性再查
for f in $files; do
  case "$f" in
    *.env|*.env.*|*/.env) echo "❌ 禁止提交环境变量文件: $f（真实值走 .secrets/ + 别名引用）" >&2; fail=1 ;;
    .secrets/*) echo "❌ 禁止提交密钥目录: $f（A 级铁律，.secrets 已 gitignore）" >&2; fail=1 ;;
  esac
done

# ---- 4. 大文件门禁（AGENTS.md 输出格式铁律） ----
for f in $files; do
  case "$f" in
    *.csv) continue ;;  # CSV 允许
  esac
  lines=$(git show :"$f" 2>/dev/null | wc -l)
  if [ "$lines" -gt 4000 ] 2>/dev/null; then
    echo "❌ 大文件超 4K 行: $f（$lines 行）——>4K 应转 CSV，禁止直接入库" >&2
    fail=1
  fi
done

# ---- 5. 仓库结构门禁（tools/lint_repo.py） ----
echo "🧹 仓库结构门禁检查…"
PY=$(ls /c/Users/*/AppData/Local/Programs/Python/Python*/python.exe 2>/dev/null | head -1)
if [ -n "$PY" ] && [ -f "$repo_root/tools/lint_repo.py" ]; then
  if ! "$PY" "$repo_root/tools/lint_repo.py" >/dev/null 2>&1; then
    "$PY" "$repo_root/tools/lint_repo.py" 2>&1 | grep -v "^INFO"
    fail=1
  fi
else
  echo "⚠ 未定位到 python.exe，跳过结构门禁（手动运行: py -3.11 tools/lint_repo.py）" >&2
fi

if [ "$fail" -ne 0 ]; then
  echo "⛔ 提交门禁未通过，提交已阻断。修正后重新 git add + commit。" >&2
  exit 1
fi

echo "✅ 提交门禁全部通过。"
exit 0
