{
  "$schema": "https://opencode.ai/config.json",
  "model": "ark-coding/deepseek-v4-flash",
  "small_model": "ollama/qwen2.5-coder:7b",
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": { "name": "qwen2.5-coder:7b" }
      }
    },
    "ark-coding": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "火山方舟 Coding Plan",
      "options": {
        "baseURL": "https://ark.cn-beijing.volces.com/api/coding/v3",
        "apiKey": "{env:ARK_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash (火山 Coding Plan)" }
      }
    }
  },
  "skills": {
    "paths": [
      ".trae/skills"
    ]
  },
  "mcp": {
    "dev-project-team-skill": {
      "type": "local",
      "command": ["py", "-3.11", "tools/mcp_server.py"],
      "enabled": true,
      "environment": {
        "START_MCP_TIMEOUT_MS": "60000",
        "RUN_MCP_TIMEOUT_MS": "300000"
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  }
}