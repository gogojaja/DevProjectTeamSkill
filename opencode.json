{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      ".trae/skills"
    ]
  },
  "mcp": {
    "dev-project-team-skill": {
      "type": "local",
      "command": ["py", "-3.11", "tools/mcp_server.py"],
      "enabled": true,
      "environment": {
        "START_MCP_TIMEOUT_MS": "60000",
        "RUN_MCP_TIMEOUT_MS": "300000"
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  }
}