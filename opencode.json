{
  "$schema": "https://opencode.ai/config.json",
  "model": "mac-ollama/qwen2.5-coder:14b",
  "small_model": "mac-ollama/nomic-embed-text:latest",
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": { "name": "qwen2.5-coder:7b" }
      }
    },
    "mac-ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Mac mini 14B (Tailscale)",
      "options": {
        "baseURL": "http://100.101.130.81:11434/v1"
      },
      "models": {
        "qwen2.5-coder:14b": { "name": "qwen2.5-coder:14b (Mac mini)" },
        "nomic-embed-text:latest": { "name": "nomic-embed-text (Mac mini)" }
      }
    },
    "ark-coding": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "火山方舟 Coding Plan",
      "options": {
        "baseURL": "https://ark.cn-beijing.volces.com/api/coding/v3",
        "apiKey": "{env:ARK_CODING_API_KEY}"
      },
      "models": {
        "doubao-seed-2.0-pro": { "name": "Doubao Seed 2.0 Pro (火山 Coding Plan)" },
        "doubao-seed-2.0-lite": { "name": "Doubao Seed 2.0 Lite (火山 Coding Plan)" }
      }
    },
    "ark-agent": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "火山方舟 Agent Plan",
      "options": {
        "baseURL": "https://ark.cn-beijing.volces.com/api/plan/v3",
        "apiKey": "{env:ARK_AGENT_API_KEY}"
      },
      "models": {
        "doubao-seed-2.0-pro": { "name": "Doubao Seed 2.0 Pro (火山 Agent Plan)" },
        "doubao-seed-2.0-lite": { "name": "Doubao Seed 2.0 Lite (火山 Agent Plan)" }
      }
    },
    "longcat": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "美团 Longcat",
      "options": {
        "baseURL": "https://longcat.chat/platform/api_keys",
        "apiKey": "{env:LONGCAT_API_KEY}"
      },
      "models": {
        "longcat-chat": { "name": "Longcat Chat" }
      }
    }
  },
  "skills": {
    "paths": [
      ".trae/skills"
    ]
  },
  "mcp": {
    "dev-project-team-skill": {
      "type": "local",
      "command": [".venv/bin/python", "tools/mcp_server/skills_mcp_server.py"],
      "enabled": true,
      "environment": {
        "START_MCP_TIMEOUT_MS": "60000",
        "RUN_MCP_TIMEOUT_MS": "300000"
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  }
}